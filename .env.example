# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored and is the ONLY place the bot
# reads credentials from. Keys never reach logs, exception messages or reports
# (safety rule 9).
# ---------------------------------------------------------------------------

# --- Kiwoom REST API -------------------------------------------------------
# Kiwoom issues SEPARATE app keys for the mock and live environments.
# Issue them at https://openapi.kiwoom.com/ and register your calling IP.
#
# On a paper run the bot does not even read the LIVE pair, so a
# misconfiguration downstream still cannot authenticate against a real
# account. Keep them in separate variables - never reuse one for both.

KIWOOM_PAPER_APP_KEY=
KIWOOM_PAPER_SECRET_KEY=

KIWOOM_LIVE_APP_KEY=
KIWOOM_LIVE_SECRET_KEY=

# Account number used for orders.
KIWOOM_ACCOUNT_NO=

# --- KRX 정보데이터시스템 (screener / pykrx) --------------------------------
# pykrx의 시장 전체 스냅샷 조회(get_market_ohlcv_by_ticker 등)는 KRX
# 정보데이터시스템 로그인을 요구한다. http://data.krx.co.kr 에서 무료
# 회원가입 후 아이디/비밀번호를 여기 채운다. 비워두면 screener.py가 매번
# "KRX 로그인 실패"로 빈 응답을 받고, 스크리너가 종일 실패한다.
KRX_ID=
KRX_PW=

# --- Paper / live switch (safety rule 2) -----------------------------------
# The bot is on PAPER unless ALL THREE of the following are true:
#   1. KIWOOM_PAPER=false                                (this file)
#   2. KIWOOM_LIVE_CONFIRM=I_UNDERSTAND_REAL_MONEY       (this file)
#   3. the command carries an explicit live request      (CLI: `live` or --live)
# Miss any one and the run is demoted to paper with a printed reason.
#
# Leave these at their safe defaults unless you really mean it.
KIWOOM_PAPER=true
KIWOOM_LIVE_CONFIRM=

# --- Telegram (optional) ---------------------------------------------------
# Leave blank to get console previews instead of real sends (safety rule 12).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- DART 전자공시 모니터 (선택) --------------------------------------------
# https://opendart.fss.or.kr/ 에서 무료 발급 후 config.yaml dart.enabled: true
DART_API_KEY=
