# ---------------------------------------------------------------------------
# Copy to .env and fill in.  .env is git-ignored and is the ONLY place the bot
# reads credentials from.  Keys are never printed to logs, exception messages
# or reports (safety rule 9).
# ---------------------------------------------------------------------------

# --- Alpaca credentials ----------------------------------------------------
# For paper trading, generate keys at https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Paper / live switch (safety rule 2) -----------------------------------
# The bot is on PAPER unless ALL THREE of the following are true:
#   1. ALPACA_PAPER=false                                (this file)
#   2. ALPACA_LIVE_CONFIRM=I_UNDERSTAND_REAL_MONEY       (this file)
#   3. the command carries an explicit live request      (CLI: `live` or --live)
# Miss any one of them and the run is demoted to paper with a printed reason.
#
# Leave these at their safe defaults unless you really mean it.
ALPACA_PAPER=true
ALPACA_LIVE_CONFIRM=

# --- Telegram (optional) ---------------------------------------------------
# Leave blank to get console previews instead of real sends (safety rule 12).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
