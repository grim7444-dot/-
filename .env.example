# 거래소 API 키 (사용할 거래소만 입력)

# 키움증권 (OpenAPI+)
KIWOOM_ACCOUNT_NO=1234567890   # 계좌번호 (숫자만)
KIWOOM_MARKET=stock            # stock(주식) 또는 futures(선물)

# Binance
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key

# Upbit
UPBIT_ACCESS_KEY=your_upbit_access_key
UPBIT_SECRET_KEY=your_upbit_secret_key

# 봇 설정
DRY_RUN=true          # true: 실제 주문 없이 시뮬레이션, false: 실제 거래
LOG_LEVEL=INFO
